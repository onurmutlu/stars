# BotFather'dan alınan token. Asla commit etme.
BOT_TOKEN=
# Webhook isteklerini doğrulayan gizli değer: en az 32 karakter, A-Z a-z 0-9 _ -
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Mini App'in yayınlandığı HTTPS adres (webhook da bunun altında: /telegram/webhook)
WEBAPP_URL=https://shop.example.com

SHOP_NAME=Stars Mağaza
# Ürünleri, destek ve koşul metinlerini kontrol etmeden true yapma.
SALES_ENABLED=false
# /paysupport ve /terms yanıtları (satış açıkken zorunlu)
SUPPORT_TEXT=Ödeme sorunları için: destek@ornek.com
TERMS_TEXT=Dijital ürün. Teslimat ödeme sonrası anında. İade talepleri 7 gün içinde /paysupport ile.

# Virgülle ayrılmış Telegram kullanıcı ID'leri: /refund ve /issues komutları
ADMIN_IDS=
PRODUCTS_PATH=products.json
DB_PATH=data/shop.sqlite3
