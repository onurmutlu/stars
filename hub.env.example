# ---- Hub: kiralık Stars mağaza altyapısı ----
# Platform botu (satıcıların paneli açtığı ve Pro planı aldığı bot). @BotFather'dan.
HUB_BOT_TOKEN=
HUB_BOT_USERNAME=
# İkisini üret: python -m app.hubcli keys
# HUB_MASTER_KEY bağlı botların token'larını şifreler: KAYBETME, değiştirme, yedekle.
HUB_MASTER_KEY=
HUB_WEBHOOK_SECRET=
# Hub'ın HTTPS adresi. Mağazalar /s/<bot>, panel /panel altında yayınlanır.
HUB_BASE_URL=https://magaza.siyahkare.com
HUB_NAME=SiyahKare Stars

# Plan: Pro aylık Star aboneliği (platform botu üzerinden satılır)
HUB_BILLING_ENABLED=true
HUB_PRO_STARS=500
HUB_TRIAL_DAYS=14
HUB_FREE_SHOPS=1
HUB_FREE_PRODUCTS=3
HUB_PRO_SHOPS=5
HUB_PRO_PRODUCTS=100
HUB_SUPPORT_TEXT=Plan ve ödeme desteği: @siyahkare_destek
HUB_TERMS_TEXT=Pro plan 30 günde bir Stars ile yenilenir, Telegram ayarlarından iptal edilebilir. Satıcı, mağazasında sattığı içerikten ve Telegram kurallarına uymaktan kendisi sorumludur.

# Virgülle ayrılmış Telegram ID'leri: platform botunda /refund ve /issues
HUB_ADMIN_IDS=
